From 54764e13eec2404de99cf85fc77b237d99604563 Mon Sep 17 00:00:00 2001
From: Dominik <dominikzeman56@gmail.com>
Date: Tue, 20 Oct 2026 11:45:27 +0000
Subject: [PATCH] midi_project: only arrangement clips (skip Session View);
 notes just before bar/loop end snap to next downbeat; CI installs soundfile

---
 .github/workflows/ci.yml   |  2 +-
 tools/midi_project.py      |  8 +++++---
 tools/test_midi_batch.py   |  4 ++--
 tools/test_midi_project.py | 20 +++++++++++++++-----
 4 files changed, 23 insertions(+), 11 deletions(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index fced7e7..d5f0c2e 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -20,7 +20,7 @@ jobs:
           cache: pip
           cache-dependency-path: pyproject.toml
       - name: Install
-        run: python -m pip install pytest numpy scipy cbor2 zstandard
+        run: python -m pip install pytest numpy scipy cbor2 zstandard soundfile
       - name: Tests
         run: python -m pytest tools -q
       - name: Repo check (sources, knowledge, preset indexes, tracks, corpus)
diff --git a/tools/midi_project.py b/tools/midi_project.py
index 90ffe1c..8e1b2f5 100644
--- a/tools/midi_project.py
+++ b/tools/midi_project.py
@@ -33,8 +33,8 @@ def grid(notes: list[tuple[float, float, int, int]], length: float) -> str:
     cells = ["."] * n
     for s, _d, _p, _v in notes:
         i = round(s * 4)
-        if abs(s * 4 - i) < 0.12 and 0 <= i < n:
-            cells[i] = "x"
+        if abs(s * 4 - i) < 0.12 and 0 <= i <= n:
+            cells[i % n] = "x"  # těsně před koncem smyčky = první šestnáctina dalšího průchodu
         elif 0 <= int(s * 4) < n:
             cells[int(s * 4)] = "+"
     return "".join(cells)
@@ -47,7 +47,7 @@ def clips(root: ET.Element) -> list[dict]:
     for t in (list(tn) if tn is not None else []):
         if t.tag != "MidiTrack":
             continue
-        for clip in t.iter("MidiClip"):
+        for clip in t.findall(".//ArrangerAutomation/Events/MidiClip"):  # jen aranž, ne klipy v Session View
             start = A.val(clip, "CurrentStart")
             end = A.val(clip, "CurrentEnd")
             a = float(A.val(clip, "Loop/LoopStart") or 0)
@@ -124,6 +124,8 @@ def timeline(cl: list[dict], track: str, include_muted: bool = False) -> dict[in
                 if off >= c["length"] - 1e-6 or (k > 0 and not c["loop_on"]):
                     break
                 pos = c["start"] + off
+                if abs(pos * 4 - round(pos * 4)) < 0.12:
+                    pos = round(pos * 4) / 4  # těsně před taktem = první šestnáctina dalšího taktu
                 b = bars.setdefault(int(pos // 4) + 1, {"cells": ["."] * 16, "pitches": set()})
                 step = (pos % 4) * 4
                 i = round(step)
diff --git a/tools/test_midi_batch.py b/tools/test_midi_batch.py
index c7c0c29..1eb8fa7 100644
--- a/tools/test_midi_batch.py
+++ b/tools/test_midi_batch.py
@@ -40,8 +40,8 @@ def clip(start, end, loop, times, key):
 
 
 def test_analyze_project_and_dedupe_copies(tmp_path):
-    xml = ('<Ableton><LiveSet><Tracks><MidiTrack Id="1"><Name><EffectiveName Value="Kick"/></Name>' + clip(0, 16, 4, [0, 1.75], 36)
-           + '</MidiTrack></Tracks><MainTrack><DeviceChain><Mixer><Tempo><Manual Value="174"/></Tempo></Mixer></DeviceChain></MainTrack></LiveSet></Ableton>')
+    xml = ('<Ableton><LiveSet><Tracks><MidiTrack Id="1"><Name><EffectiveName Value="Kick"/></Name><ArrangerAutomation><Events>' + clip(0, 16, 4, [0, 1.75], 36)
+           + '</Events></ArrangerAutomation></MidiTrack></Tracks><MainTrack><DeviceChain><Mixer><Tempo><Manual Value="174"/></Tempo></Mixer></DeviceChain></MainTrack></LiveSet></Ableton>')
     data = gzip.compress(ET.tostring(ET.fromstring(xml)))
     (tmp_path / "a.als").write_bytes(data)
     (tmp_path / "a Copy.als").write_bytes(data)
diff --git a/tools/test_midi_project.py b/tools/test_midi_project.py
index 0ad332f..6451801 100644
--- a/tools/test_midi_project.py
+++ b/tools/test_midi_project.py
@@ -7,12 +7,13 @@ def ev(t, d=0.5):
     return f'<MidiNoteEvent Time="{t}" Duration="{d}" Velocity="100" IsEnabled="true"/>'
 
 
-def doc(clips):
+def doc(clips, session=""):
     body = "".join(
         f'<MidiClip><CurrentStart Value="{s}"/><CurrentEnd Value="{e}"/><Loop><LoopStart Value="0"/><LoopEnd Value="{ln}"/></Loop>'
         f'<Notes><KeyTracks><KeyTrack><Notes>{"".join(ev(t) for t in ts)}</Notes><MidiKey Value="{k}"/></KeyTrack></KeyTracks></Notes></MidiClip>'
         for s, e, ln, ts, k in clips)
-    return ET.fromstring(f'<Ableton><LiveSet><Tracks><MidiTrack Id="1"><Name><EffectiveName Value="Bass"/></Name>{body}</MidiTrack></Tracks></LiveSet></Ableton>')
+    return ET.fromstring(f'<Ableton><LiveSet><Tracks><MidiTrack Id="1"><Name><EffectiveName Value="Bass"/></Name>'
+                         f'<ClipSlotList><ClipSlot>{session}</ClipSlot></ClipSlotList><ArrangerAutomation><Events>{body}</Events></ArrangerAutomation></MidiTrack></Tracks></LiveSet></Ableton>')
 
 
 def test_grid_marks_hits_and_off_grid():
@@ -32,7 +33,10 @@ def test_same_pattern_gets_one_id_and_positions():
 
 
 def test_track_filter_and_clips_without_arrangement_skipped():
-    cl = P.clips(doc([(0, 4, 4, [0], 38)]))
+    session = ('<MidiClip><CurrentStart Value="0"/><CurrentEnd Value="4"/><Loop><LoopStart Value="0"/><LoopEnd Value="4"/></Loop>'
+               f'<Notes><KeyTracks><KeyTrack><Notes>{ev(1)}</Notes><MidiKey Value="40"/></KeyTrack></KeyTracks></Notes></MidiClip>')
+    cl = P.clips(doc([(0, 4, 4, [0], 38)], session))
+    assert len(cl) == 1 and cl[0]["notes"] == [(0.0, 0.5, 38, 100)]
     assert P.report(cl, "zzz") == {} and "Bass" in P.report(cl, "bas")
 
 
@@ -44,8 +48,8 @@ def mk(start, end, loop, times, key=36, loop_on="true", rel=0):
 
 
 def doc2(*clips_xml):
-    return ET.fromstring('<Ableton><LiveSet><Tracks><MidiTrack Id="1"><Name><EffectiveName Value="Kick"/></Name>' + "".join(clips_xml)
-                         + '</MidiTrack></Tracks></LiveSet></Ableton>')
+    return ET.fromstring('<Ableton><LiveSet><Tracks><MidiTrack Id="1"><Name><EffectiveName Value="Kick"/></Name><ArrangerAutomation><Events>'
+                         + "".join(clips_xml) + '</Events></ArrangerAutomation></MidiTrack></Tracks></LiveSet></Ableton>')
 
 
 def test_timeline_unrolls_loop_to_clip_end():
@@ -99,3 +103,9 @@ def test_audio_hits_use_the_same_timeline():
     ac = P.audio_clips(audio_doc(aclip(0, 0.25) + aclip(2.5, 2.75)))
     tl = P.timeline(P.audio_as_hits(ac), "Chops")
     assert "".join(tl[1]["cells"]) == "x.........x....."
+
+
+def test_note_just_before_bar_end_is_next_downbeat():
+    assert P.grid([(3.97, .25, 36, 100), (1.98, .25, 36, 100)], 4.0) == "x.......x......."
+    tl = P.timeline(P.clips(doc2(mk(0, 8, 8, [3.97], loop_on="false"))), "Kick")
+    assert list(tl) == [2] and "".join(tl[2]["cells"]) == "x..............."
-- 

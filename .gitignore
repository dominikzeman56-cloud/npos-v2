# Downloaded models (faster-whisper etc.) — not source
models/

# Claude Code session artifacts
.claude/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Transcript artifacts (large text dumps)
transcripts/

# Full preset dumps from paid packs stay local (index in data/presets/index/ is the shareable part)
data/presets/_local/

# Lokální kopie zdrojů (placené kurzy, presety, projekty): jen na tomhle počítači, viz tools/collect_local_sources.py
_sources/

# Plné analýzy presetů z placených packů (redistribution: none) zůstávají jen lokálně
data/presets/analyzed/

# Local generator config (paths on the user machine)
tools/vault-app/.env.local

# podrobné MIDI rozbory po projektech (názvy projektů a packů), jen lokálně
data/midi/_local/

# analýzy stemů (energie po taktech z cizích stemů), jen lokálně
data/stems/_local/

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NPOS Build Sheet (stavební list)",
  "description": "Rozhodnutí o jednom tracku: cíl, reference, archetyp basy, vrstvy. Výčty viz docs/BLUEPRINT.md §5.",
  "type": "object",
  "required": ["id", "title", "created", "bpm", "key", "reference", "goal"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "created": { "type": "string", "format": "date" },
    "status": {
      "type": "string",
      "enum": ["idea", "groove", "drop", "arrange", "mix", "master", "done"]
    },
    "bpm": { "type": "number" },
    "key": { "type": "string" },
    "template": { "type": "string", "description": "Např. NEUROFUNK_TEMPLATE_FINAL." },
    "reference": {
      "type": "object",
      "description": "Reference musí být ověřený zdroj: source_id z knowledge/sources.jsonl nebo track_id z data/tracks.",
      "properties": {
        "track": { "type": "string" },
        "artist": { "type": "string" },
        "why": { "type": "string" },
        "source_id": { "type": "string" }
      }
    },
    "bass": {
      "type": "object",
      "properties": {
        "archetype": { "type": "string" },
        "layers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["sub", "body", "movement", "noise", "texture"]
          }
        }
      }
    },
    "drums": {
      "type": "object",
      "properties": {
        "kick_style": { "type": "string" },
        "snare_style": { "type": "string" }
      }
    },
    "lead": {
      "type": "object",
      "properties": {
        "playing_style": { "type": "string" },
        "roles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "goal": { "type": "string" },
    "problem": { "type": "string" },
    "unique_idea": { "type": "string" },
    "notes": { "type": "string" }
  }
}
